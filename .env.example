# Copy to .env and fill in the providers you use. Unset providers are skipped.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Enable a provider whose SDK finds credentials without a key variable
# (e.g. after `ant auth login`):
# M3DS_ENABLED_PROVIDERS=anthropic

# SQLite by default; use Postgres for anything shared:
# M3DS_DATABASE_URL=postgresql+asyncpg://m3ds:m3ds@localhost:5432/m3ds
# M3DS_AUTO_CREATE_SCHEMA=false   # when using `alembic upgrade head`

# Protect the HTTP API (clients send X-API-Key).
# M3DS_API_KEY=

# M3DS_SYSTEM_PROMPT="You are ..."
# M3DS_MODELS_CONFIG=config/models.yaml

# Export traces over OTLP (Langfuse, Jaeger, Tempo, ...). Needs `uv sync --extra otlp`.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
